[Unit]
Description=ROTD — Runner of the Day
Documentation=https://github.com/Ace1337z/big-whale-penny-tracker
After=network-online.target
Wants=network-online.target
# Start-limit settings live in [Unit] (modern systemd rejects them in [Service]):
# panic-stop a crash loop after 3 restarts within 60s instead of restarting forever.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@INSTALL_DIR@
Environment=ROTD_HOME=@INSTALL_DIR@
Environment=ROTD_CONFIG=@INSTALL_DIR@/config.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@INSTALL_DIR@/.venv/bin/rotd --config @INSTALL_DIR@/config.env listen
Restart=always
RestartSec=5

# Modest hardening; the process needs outbound HTTPS only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@INSTALL_DIR@

[Install]
WantedBy=multi-user.target
