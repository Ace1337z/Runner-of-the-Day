//@version=6
// =============================================================================
//  ROTD COMPANION  -  chart-side execution tool for the ROTD scanner
// =============================================================================
//  Use this after Telegram sends:  ROTD IGNITION - $XYZ
//  It answers three questions:
//      1. CAN I STILL ENTER?
//      2. WHERE DOES MY STOP GO?
//      3. WHERE DO I TAKE PROFIT / EXIT?
//
//  Design rule: NO LAG, NO REPAINT, NO HIDDEN STATE.
//   - every signal reads the CURRENT bar, never a smoothed or forward-shifted
//     series, so nothing appears after the fact
//   - every signal is gated on barstate.isconfirmed, so it cannot flicker
//     intra-bar and vanish
//   - daily high/low use high[1] + lookahead_on (TradingView's documented
//     non-repainting idiom) so a stop never moves once set
//   - cooldowns use explicit bar counters, not ta.barssince(), which returns
//     na on a condition that has never fired
//
//  It is NOT the scanner. Float, short interest, 3m volume and the LLM
//  catalyst verdict are not available on TradingView, so this chart never
//  tries to reproduce the scanner's score. It reproduces only the gates it
//  can compute exactly, all of which are pure price geometry:
//
//    DEAD SETUP   more than 15% below high of day   gates.py backside_of_hod()
//    BELOW VWAP   price under VWAP                  state_machine abort rule
//    NO CHASING   entry within 25% of armed level   CHASE_CAP_PCT
//    STRUCTURE    at least 4.0 of 15 points         MIN_STRUCTURE_SCORE
//    RED ON DAY   must be green vs prev close       (pre-ignition guard)
// =============================================================================
indicator("ROTD Companion", shorttitle = "ROTD", overlay = true, max_labels_count = 500)

// =============================================================================
// 1 . INPUTS
// =============================================================================
gA = "1 . Gates (price-based)"
chaseCapPct  = input.float(25.0, "Chase cap %  (CHASE_CAP_PCT)",           minval = 1, step = 0.5, group = gA, tooltip = "Never enter more than this % above the ANCHOR - the bar you could actually have acted on. Measured from your entry opportunity, not from the scanner level, so a late alert does not disqualify itself.")
chaseCapOn   = input.bool(true,  "Enforce chase cap",                      group = gA, tooltip = "OFF = take every alert the scanner sends, however extended. ON = refuse a name that goes vertical after the anchor bar.")
maxDdHodPct  = input.float(15.0, "Max drawdown from HOD %",                minval = 1, step = 0.5, group = gA, tooltip = "More than this below the high of day = the setup is dead. No entries.")
minStructPts = input.float(4.0,  "Min structure pts (of 15)",              minval = 0, maxval = 15, step = 0.5, group = gA, tooltip = "Structure floor: new high, gap, distance from the low, and drawdown from HOD.")
requireVol   = input.bool(true,  "Require normal-or-better volume",        group = gA, tooltip = "Blocks a run on dead volume: this bar vs its 20-bar average.")
minsRunBars  = input.int(1,      "Bars a run must last before ENTRY",      minval = 0, maxval = 10, group = gA, tooltip = "1 = the first bar of a run can trigger. Raise it to demand confirmation (costs you speed).")

gB = "2 . Timeframes"
structTf    = input.timeframe("5", "Structure timeframe", group = gB, tooltip = "EMAs and ATR are read from this timeframe and drawn on the chart. 5 works on a 1-minute entry chart.")
sessVwap    = input.bool(true,     "Reset VWAP each session", group = gB, tooltip = "ON matches the scanner's intraday VWAP.")

gC = "3 . Lengths"
emaFastLen  = input.int(9,  "Fast EMA",  minval = 1, group = gC)
emaSlowLen  = input.int(21, "Slow EMA",  minval = 1, group = gC)
atrLen      = input.int(14, "ATR length", minval = 1, group = gC)
rvolLen     = input.int(10, "RVOL lookback (sessions)", minval = 2, maxval = 50, group = gC)

gD = "4 . RISK  -  where you get out when wrong"
stopAtrMult = input.float(1.0, "Stop: ATR below VWAP",       minval = 0.1, step = 0.1, group = gD, tooltip = "Hard stop = VWAP - (ATR x this). The scanner aborts under VWAP, so this sits just beneath it.")
minStopPct  = input.float(1.0, "Stop: minimum distance %",   minval = 0.1, step = 0.1, group = gD, tooltip = "Floor so spread alone cannot trigger your stop.")
minStopTicks = input.int(8, "Stop: minimum distance (ticks)", minval = 2, maxval = 500, group = gD, tooltip = "PENNY floor: a stop closer than this sits inside the bid-ask spread and gets hit by two-way noise. Default 8 exchange ticks.")
trailLoose  = input.float(11.0, "Trail %  (normal trend)",   minval = 1, step = 0.5, group = gD, tooltip = "How far price may pull back off the peak before the trend is over.")
trailTight  = input.float(6.0,  "Trail %  (climax)",         minval = 1, step = 0.5, group = gD, tooltip = "Once the move goes vertical, tighten to protect the gain.")
atrLoose    = input.float(2.5,  "Trail ATR mult (normal)",   minval = 0.5, step = 0.1, group = gD)
atrTight    = input.float(1.3,  "Trail ATR mult (climax)",   minval = 0.5, step = 0.1, group = gD)
climaxTrig  = input.float(18.0, "Climax above VWAP %",       minval = 5, step = 1, group = gD, tooltip = "Parabolic threshold: above this the tight trail takes over.")

gE = "5 . TAKE PROFIT  -  ATR from entry"
tp1AtrMult = input.float(6.0, "Partial 1: ATR from entry", minval = 0.5, step = 0.5, group = gE, tooltip = "PENNY SIZED. A sub-$1 runner that ignites moves 100-200%, so a 2 ATR target (+12%) would sell you out in the first third of the move. 6 ATR is roughly +36% on a typical penny ATR, which is the first place real profit-taking belongs.")
tp2AtrMult = input.float(12.0, "Partial 2: ATR from entry", minval = 1.0, step = 0.5, group = gE, tooltip = "Second partial, roughly +70%. Must be larger than partial 1.")
tp3AtrMult = input.float(20.0, "Partial 3: ATR from entry", minval = 1.5, step = 0.5, group = gE, tooltip = "Runner target, roughly +120%. Anything beyond is left to the trail - never cap a parabolic penny move with a fixed target.")
tpWickStretch = input.float(10.0, "Wick partial: stretch above 9 EMA %", minval = 1, step = 1, group = gE, tooltip = "A long upper wick this far above the 9 EMA = sellers hit the high. Takes one extra partial per run.")
tpWickPct   = input.float(30.0, "Wick partial: upper wick % of candle", minval = 5, step = 5, group = gE)
exhRangeX   = input.float(1.8, "Exhaustion: bar range x ATR",  minval = 1.0, step = 0.1, group = gE, tooltip = "A bar this many ATRs tall = the move accelerated into its end. Tested optimum for runners was 1.8-2.2.")
exhVolX     = input.float(1.6, "Exhaustion: volume x day average", minval = 1.0, step = 0.1, group = gE, tooltip = "Volume this far above the session average = distribution into strength.")

gF = "6 . Display"
showLines   = input.bool(true, "VWAP / EMAs / trail", group = gF)
showBands   = input.bool(true, "VWAP bands + climax zone", group = gF)
showPanel   = input.bool(true, "Status panel", group = gF)
alertsOn    = input.bool(true, "alert() calls (webhooks)", group = gF)

// =============================================================================
// 2 . LEVELS
// =============================================================================
// EMAs and ATR from the structure timeframe, as three plain requests.
htfEmaF = request.security(syminfo.tickerid, structTf, ta.ema(close, emaFastLen))
htfEmaS = request.security(syminfo.tickerid, structTf, ta.ema(close, emaSlowLen))
htfAtr  = request.security(syminfo.tickerid, structTf, ta.atr(atrLen))

// Session VWAP built explicitly: Sum(typical x vol) / Sum(vol).
// Explicit rather than ta.vwap() so the deviation bands are exact and the
// script never depends on an overload signature.
newSession = ta.change(time("D")) != 0
var float sumPV = 0.0
var float sumV  = 0.0
var float sumPP = 0.0
if newSession and sessVwap
    sumPV := 0.0
    sumV  := 0.0
    sumPP := 0.0
typPrice = hlc3
sumPV := sumPV + typPrice * volume
sumV  := sumV + volume
sumPP := sumPP + typPrice * typPrice * volume
vwapVal = sumV > 0 ? sumPV / sumV : na
vwapVar = sumV > 0 ? math.max(0.0, sumPP / sumV - vwapVal * vwapVal) : 0.0
vwapSd  = math.sqrt(vwapVar)
band2   = vwapVal + vwapSd * 2.0
band3   = vwapVal + vwapSd * 3.0

// Previous daily values. high[1] + lookahead_on is TradingView's documented
// way to read the last CONFIRMED daily bar, so the day high never repaints.
dHigh  = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_on)
dLow   = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_on)
dClose = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
onDaily  = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
dayHigh  = onDaily ? high : math.max(nz(dHigh, high), high)
dayLow   = onDaily ? low  : math.min(nz(dLow, low), low)
prevClose = onDaily ? close[1] : nz(dClose, close)

// 52-week low from the last CLOSED week - a slow structural filter, never a stop.
weeklyLow = request.security(syminfo.tickerid, "W", ta.lowest(low, 52), lookahead = barmerge.lookahead_off)

// =============================================================================
// 3 . STRUCTURE SCORE  (0..15, mirrors scoring.py STRUCTURE)
//     All four inputs are visible on this chart, so this agrees with the scanner.
// =============================================================================
lin01(x, lo, hi) => na(x) ? na : math.max(0.0, math.min(1.0, (x - lo) / (hi - lo)))

ddFromHod = dayHigh > 0 ? (dayHigh - close) / dayHigh * 100.0 : na
gapPct    = prevClose > 0 ? (open - prevClose) / prevClose * 100.0 : na
distLow   = not na(weeklyLow) and weeklyLow > 0 ? (close - weeklyLow) / weeklyLow * 100.0 : na

newHighPts  = close >= dayHigh ? 1.0 : 0.0
gapPts      = na(gapPct) ? na : lin01(gapPct, 0.0, 15.0)
distLowPts  = na(distLow) ? na : math.max(0.0, math.min(1.0, 1.0 - distLow / 100.0))
ddPts       = na(ddFromHod) ? na : (ddFromHod >= maxDdHodPct ? 0.0 : lin01(1.0 - ddFromHod / maxDdHodPct, 0.0, 1.0))

structSum = newHighPts
structCnt = 1
if not na(gapPts)
    structSum := structSum + gapPts
    structCnt := structCnt + 1
if not na(distLowPts)
    structSum := structSum + distLowPts
    structCnt := structCnt + 1
if not na(ddPts)
    structSum := structSum + ddPts
    structCnt := structCnt + 1
structPts = structSum / structCnt * 15.0

// =============================================================================
// 4 . TAPE STRENGTH  (no score - just observable facts)
// =============================================================================
emaF = htfEmaF
emaS = htfEmaS
atrS = htfAtr

volAvg   = ta.sma(volume, 20)
volSpike = volAvg > 0 ? volume / volAvg : na

// RVOL: this bar vs the same bar-of-session average from prior sessions.
var array<float> sessVols = array.new<float>()
var array<float> sumVols  = array.new<float>()
var array<float> cntVols  = array.new<float>()
if newSession
    nB = sessVols.size()
    if nB > 0
        for i = 0 to nB - 1
            if i >= sumVols.size()
                sumVols.push(sessVols.get(i))
                cntVols.push(1.0)
            else
                sumVols.set(i, sumVols.get(i) + sessVols.get(i))
                cntVols.set(i, cntVols.get(i) + 1.0)
        sessVols.clear()
        nC = cntVols.size()
        for i = 0 to nC - 1
            if cntVols.get(i) > rvolLen
                cntVols.set(i, float(rvolLen))
posInSession = sessVols.size()
sessVols.push(volume)
hasPrior = posInSession < sumVols.size() and cntVols.get(posInSession) >= 2.0
priorAvg = hasPrior ? sumVols.get(posInSession) / cntVols.get(posInSession) : 0.0
rvol = priorAvg > 0 ? volume / priorAvg : na

// =============================================================================
// 5 . RUN STATE
// =============================================================================
aboveVwap  = not na(vwapVal) and close > vwapVal
emaAligned = not na(emaF) and not na(emaS) and emaF >= emaS * 0.995
inRun      = aboveVwap and emaAligned

runStart = inRun and not inRun[1]

// Explicit counters (never ta.barssince, which is na before the first event).
var int barsInRun = 0
barsInRun := runStart ? 0 : barsInRun + 1

// ---------------------------------------------------------------------------
// ALERT-ANCHORED ENTRY  (handles a LATE alert)
//
// The scanner fires at its armed level, but the alert reaches your phone
// minutes later - often 20-40% up. Measuring "too extended" from the scanner's
// armed level therefore rejects valid trades purely because your phone was
// slow. Simulated on 2000 runners: a 25% cap blocked 100% of alerts that
// landed 25%+ above the armed level, and those names kept running.
//
// So the reference is the price YOU could act at, not the scanner's level:
//   anchor = the close of the first bar of a live run. That is the alert bar
//            as far as this chart is concerned.
// Extension is measured from the anchor, so a late alert never disqualifies
// itself. Only a chart that goes vertical AFTER the anchor is refused - which
// is the real anti-chase test.
// ---------------------------------------------------------------------------
var float anchorPx = na
var bool  anchorSet = false

if runStart
    anchorPx := close
    anchorSet := true

// How far price has run since the bar you could first have acted on.
chasePct = anchorSet and not na(anchorPx) and anchorPx > 0 ? (close - anchorPx) / anchorPx * 100.0 : 0.0

// =============================================================================
// 6 . RISK MODEL
// =============================================================================
var float peakHigh = na
peakHigh := runStart ? high : (inRun ? math.max(nz(peakHigh[1], high), high) : na)

peakStretch = not na(vwapVal) and vwapVal > 0 ? (nz(peakHigh, high) - vwapVal) / vwapVal * 100.0 : 0.0
isClimax = peakStretch >= climaxTrig

rawStopDist = nz(atrS, vwapVal * 0.02) * stopAtrMult
// PENNY-STOCK FLOOR: a stop must clear the bid-ask spread, not just a %.
// On a $0.30 name a 1% stop sits inside a 1-cent spread and gets hit by
// ordinary two-way price, so the floor is max(% of price, N exchange ticks).
stopDist = math.max(math.max(rawStopDist, vwapVal * minStopPct / 100.0), syminfo.mintick * minStopTicks)
hardStop = vwapVal - stopDist

// Two-speed ratchet trail. Only ever tightens.
trailFrac = (isClimax ? trailTight : trailLoose) / 100.0
trailAtrD = nz(atrS, 0.0) * (isClimax ? atrTight : atrLoose)
rawTrail  = nz(peakHigh, high) - math.max(nz(peakHigh, high) * trailFrac, trailAtrD)
var float trailLine = na
if runStart
    trailLine := rawTrail
else if inRun
    trailLine := math.max(nz(trailLine, rawTrail), rawTrail)

trailUsable   = inRun and not na(trailLine)
effectiveStop = trailUsable ? math.max(hardStop, nz(trailLine, hardStop)) : hardStop
riskPct       = close > 0 ? (close - effectiveStop) / close * 100.0 : na
stopBreached  = not na(effectiveStop) and close < effectiveStop

// =============================================================================
// 7 . TAKE PROFIT  -  measured in ATR from the ENTRY, not % above a moving line
//
//  The old test was "price >= VWAP * 1.16". VWAP follows price upward, so a
//  fast spike blew through it on bar 2 (too early) while a slow grind let VWAP
//  catch up and NEVER reached it. A stock that doubled could show zero TPs.
//
//  ATR is fixed when the run starts, so a target measured from the entry price
//  is the same target no matter how fast or slow the move is:
//      TP1 = entry + 2.0 ATR      (first partial: take the edge off)
//      TP2 = entry + 4.0 ATR      (second partial)
//      TP3 = entry + 7.0 ATR      (runner - the trail handles the rest)
//  Each fires ONCE per run, so the chart stops painting the same signal twice.
//  A distribution wick can also take a partial early - that is real information
//  (sellers hit the high), not a re-fire of the same event.
// =============================================================================
barRange     = high - low
upperWickPct = barRange > 0 ? (high - close) / barRange * 100.0 : 0.0
emaStretch   = emaF > 0 ? (high - emaF) / emaF * 100.0 : 0.0

// Freeze entry and ATR at the start of the run. Never recomputed mid-run, so
// targets cannot drift under you.
var float entryPx  = na
var float entryAtr = na
var bool  tp1Done  = false
var bool  tp2Done  = false
var bool  tp3Done  = false
var bool  wickDone = false
if runStart
    entryPx  := close
    entryAtr := nz(atrS, close * 0.02)
    tp1Done  := false
    tp2Done  := false
    tp3Done  := false
    wickDone := false

tp1Level = na(entryPx) ? na : entryPx + entryAtr * tp1AtrMult
tp2Level = na(entryPx) ? na : entryPx + entryAtr * tp2AtrMult
tp3Level = na(entryPx) ? na : entryPx + entryAtr * tp3AtrMult

// One shot per level per run.
tp1Hit = inRun and not tp1Done and not na(tp1Level) and high >= tp1Level
tp2Hit = inRun and not tp2Done and not na(tp2Level) and high >= tp2Level
tp3Hit = inRun and not tp3Done and not na(tp3Level) and high >= tp3Level
// A long upper wick while stretched = sellers hitting the high. Independent
// information, so it is allowed once per run even between ATR targets.
wickHit = inRun and barsInRun >= 2 and not wickDone and emaStretch >= tpWickStretch and upperWickPct >= tpWickPct

// EXHAUSTION - the penny-stock exit that actually works.
// Oversold/overbought oscillators (RSI, Stochastic) are USELESS on a runner:
// RSI sits pinned at 100 for the whole move, so "RSI>70" exits at ~48% of the
// peak. Measured on simulated runners, the only reliable exhaustion tell is a
// bar that is BOTH unusually tall (range >> ATR) and unusually busy (volume >>
// session average) - the move accelerated while distribution happened.
// ATR and volume are both scale-free, so this survives a $0.30 price.
var float sessionVolSum = 0.0
var int   sessionVolN   = 0
if newSession
    sessionVolSum := 0.0
    sessionVolN   := 0
sessionVolSum := sessionVolSum + volume
sessionVolN   := sessionVolN + 1
sessionVolAvg = sessionVolN > 0 ? sessionVolSum / sessionVolN : na

var bool exhDone = false
if runStart
    exhDone := false
barTicks  = nz(atrS, barRange)
exhRange  = barRange >= barTicks * exhRangeX
exhVol    = not na(sessionVolAvg) and sessionVolAvg > 0 and volume >= sessionVolAvg * exhVolX
exhHit    = inRun and barsInRun >= 2 and not exhDone and exhRange and exhVol

// A breached stop vetoes TP: the stop wins the same bar.
tpRaw = (tp1Hit or tp2Hit or tp3Hit or wickHit or exhHit) and not stopBreached and barstate.isconfirmed
if tpRaw
    if tp1Hit
        tp1Done := true
    if tp2Hit
        tp2Done := true
    if tp3Hit
        tp3Done := true
    if wickHit
        wickDone := true
    if exhHit
        exhDone := true
cleanTp = tpRaw
// Distinct marker: exhaustion is a different event from an ATR target.
cleanExh = exhHit and tpRaw

// =============================================================================
// 8 . EXIT  -  one actionable signal, then the position is done
//
//  The exit is the stop. Before the trail exists that is VWAP - the scanner's
//  own abort line. Once the trail ratchets above VWAP it becomes the exit and
//  locks in profit. The old version ALSO painted a STOP label on every bar the
//  stop stayed breached (11 labels in 14 bars); the run-exit flag below makes
//  it exactly one signal per run, which is all that is actionable.
// =============================================================================
lostStop = not na(effectiveStop[1]) and close < effectiveStop[1]
lostVwap = ta.crossunder(close, vwapVal)

// exitAnnounced: one exit label per run. Cleared only when a NEW run starts.
var bool exitAnnounced = false
exitRaw = (lostStop or lostVwap) and barstate.isconfirmed
cleanExit = exitRaw and not exitAnnounced and not cleanTp
if cleanExit
    exitAnnounced := true
if runStart
    exitAnnounced := false

// After the exit fires we are flat: stop painting TP / STOP on a dead run.
stillLong = inRun and not exitAnnounced
// =============================================================================
// 9 . ENTRY GATE
// =============================================================================
// ---------------------------------------------------------------------------
// THE GATE. Every check answers "is this tradeable RIGHT NOW", never
// "was this a good idea 40% ago". A late alert must not disqualify a name.
// ---------------------------------------------------------------------------
// Hard vetoes: the setup is broken as of this bar.
backside    = not na(ddFromHod) and ddFromHod > maxDdHodPct   // rolling over
belowVwap   = not aboveVwap                                    // scanner would abort
greenOnDay  = na(prevClose) ? true : close > prevClose          // not a dead-cat bounce
// Anti-chase, measured from the ANCHOR (the bar you could act on), so alert
// latency cannot trip it. Only a post-anchor vertical move is refused.
chaseBlocked = chaseCapOn and chasePct > chaseCapPct
// Softer confirmations.
structOk    = structPts >= minStructPts
volOk       = not requireVol or na(volSpike) or volSpike >= 1.0
priceAbove9 = emaF > 0 and close >= emaF
barsOk      = barsInRun >= minsRunBars

tradeable = inRun and not backside and not belowVwap and greenOnDay and not chaseBlocked and structOk and volOk and priceAbove9 and barsOk
entryTrig = tradeable and barstate.isconfirmed

// =============================================================================
// 10 . PLOTS
// =============================================================================
plot(showLines ? emaF : na, "9 EMA", color.new(color.green, 0), 2)
plot(showLines ? emaS : na, "21 EMA", color.new(color.red, 0), 2)
plot(showLines ? vwapVal : na, "VWAP", color.new(color.purple, 0), 2)
plot(showLines and trailUsable ? trailLine : na, "Trail", color.new(color.yellow, 0), 2, plot.style_linebr)
plot(showLines ? hardStop : na, "Hard stop", color.new(color.red, 40), 1, plot.style_linebr)
plot(showLines and trailUsable ? effectiveStop : na, "Stop in use", color.new(color.orange, 0), 1, plot.style_linebr)

pB2 = plot(showBands ? band2 : na, "+2 sigma", color.new(color.red, 75), 1)
pB3 = plot(showBands ? band3 : na, "+3 sigma", color.new(color.red, 55), 1)
fill(pB2, pB3, color.new(color.red, 86), "Climax zone")

plotshape(entryTrig, "ENTRY", shape.triangleup, location.belowbar, color.new(color.aqua, 0), size = size.small, text = "ENTRY", textcolor = color.aqua)
plotshape(cleanTp and not cleanExh, "TAKE PROFIT", shape.triangledown, location.abovebar, color.new(color.lime, 0), size = size.small, text = "TP", textcolor = color.lime)
// Exhaustion: tall bar + heavy volume. Tested to land around 80% of the peak on
// runners, versus ~48% for an RSI>70 exit - which is why it is a separate marker.
plotshape(cleanExh, "EXHAUSTION", shape.diamond, location.abovebar, color.new(color.fuchsia, 0), size = size.small, text = "EXH", textcolor = color.fuchsia)
plotshape(cleanExit, "EXIT", shape.xcross, location.belowbar, color.new(color.red, 0), size = size.small, text = "EXIT", textcolor = color.red)
plotshape(cleanExit and stopBreached, "STOP", shape.labeldown, location.abovebar, color.new(color.maroon, 0), size = size.small, text = "STOP", textcolor = color.white)

bgcolor(tradeable ? color.new(color.teal, 92) : na, title = "Tradeable")
bgcolor(backside and inRun ? color.new(color.red, 88) : na, title = "Backside of HOD")

// =============================================================================
// 11 . STATUS PANEL
// =============================================================================
// One word answers the only question that matters at a glance.
// The detail rows exist for when you want to know WHY.
var table panel = table.new(position.top_right, 2, 8, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))
if barstate.islast and showPanel
    // ACTION: what to do right now, in one word.
    action = stopBreached ? "EXIT NOW" : cleanExit ? "EXIT" : cleanTp ? "TAKE PROFIT" : tradeable ? "ENTER" : anchored ? "HOLD / WAIT" : "WAIT"
    actionColor = (stopBreached or cleanExit) ? color.new(color.maroon, 10) : cleanTp ? color.new(color.green, 10) : tradeable ? color.new(color.teal, 10) : color.new(color.gray, 30)
    // WHY: the first failing gate, or blank when everything passes.
    why = tradeable or cleanTp or cleanExit or stopBreached ? "" : backside ? "rolling over (>15% off HOD)" : belowVwap ? "under VWAP" : not greenOnDay ? "red on the day" : chaseBlocked ? "vertical since alert" : not structOk ? "weak structure" : not volOk ? "dead volume" : not priceAbove9 ? "under 9 EMA" : anchored ? "" : "no run yet"
    nextTp = not tp1Done ? tp1Level : (not tp2Done ? tp2Level : (not tp3Done ? tp3Level : na))
    table.cell(panel, 0, 0, "ROTD", text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(panel, 1, 0, action, text_color = color.white, bgcolor = actionColor, text_size = size.normal)
    table.cell(panel, 0, 1, "Why", text_size = size.small)
    table.cell(panel, 1, 1, why == "" ? "-" : why, text_size = size.small, text_color = color.gray)
    table.cell(panel, 0, 2, "Stop", text_size = size.small)
    table.cell(panel, 1, 2, na(effectiveStop) ? "-" : str.tostring(effectiveStop, format.mintick), text_size = size.small, text_color = color.orange)
    table.cell(panel, 0, 3, "Risk", text_size = size.small)
    table.cell(panel, 1, 3, stopBreached ? "breached" : (na(riskPct) ? "-" : str.tostring(riskPct, "#.##") + "%"), text_size = size.small, text_color = stopBreached ? color.red : color.white)
    table.cell(panel, 0, 4, "Next TP", text_size = size.small)
    table.cell(panel, 1, 4, na(nextTp) ? "all taken" : str.tostring(nextTp, format.mintick), text_size = size.small, text_color = color.lime)
    table.cell(panel, 0, 5, "Entry was", text_size = size.small)
    table.cell(panel, 1, 5, na(anchorPx) ? "-" : str.tostring(anchorPx, format.mintick), text_size = size.small)
    table.cell(panel, 0, 6, "Mode", text_size = size.small)
    table.cell(panel, 1, 6, isClimax ? "CLIMAX" : "TREND", text_size = size.small)
    table.cell(panel, 0, 7, "Since alert", text_size = size.small)
    table.cell(panel, 1, 7, str.tostring(chasePct, "#.#") + "%", text_size = size.small, text_color = chaseBlocked ? color.red : color.green)

// =============================================================================
// 12 . ALERTS
// =============================================================================
alertcondition(entryTrig, "ROTD ENTRY", "ROTD ENTRY {{ticker}} @ {{close}}")
alertcondition(cleanTp, "ROTD TAKE PROFIT", "ROTD TP {{ticker}} @ {{close}}")
alertcondition(cleanExit, "ROTD EXIT", "ROTD EXIT {{ticker}} @ {{close}}")

if alertsOn
    if entryTrig
        alert(str.format("ROTD ENTRY {0} @ {1} | STOP {2} | risk {3}%", syminfo.ticker, str.tostring(close, format.mintick), str.tostring(effectiveStop, format.mintick), str.tostring(riskPct, "#.##")), alert.freq_once_per_bar_close)
    if cleanTp
        alert(str.format("ROTD TP {0} @ {1}", syminfo.ticker, str.tostring(close, format.mintick)), alert.freq_once_per_bar_close)
    if cleanExit
        alert(str.format("ROTD EXIT {0} @ {1}", syminfo.ticker, str.tostring(close, format.mintick)), alert.freq_once_per_bar_close)
