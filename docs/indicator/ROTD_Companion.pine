//@version=6
// =============================================================================
//  ROTD COMPANION  -  chart-side execution tool for the ROTD scanner
// =============================================================================
//  Use this after Telegram sends:  ROTD IGNITION - $XYZ
//  It answers three questions:
//      1. CAN I STILL ENTER?
//      2. WHERE DOES MY STOP GO?
//      3. WHERE DO I TAKE PROFIT / EXIT?
//
//  Design rule: NO LAG, NO REPAINT, NO HIDDEN STATE.
//   - every signal reads the CURRENT bar, never a smoothed or forward-shifted
//     series, so nothing appears after the fact
//   - every signal is gated on barstate.isconfirmed, so it cannot flicker
//     intra-bar and vanish
//   - daily high/low use high[1] + lookahead_on (TradingView's documented
//     non-repainting idiom) so a stop never moves once set
//   - cooldowns use explicit bar counters, not ta.barssince(), which returns
//     na on a condition that has never fired
//
//  It is NOT the scanner. Float, short interest, 3m volume and the LLM
//  catalyst verdict are not available on TradingView, so this chart never
//  tries to reproduce the scanner's score. It reproduces only the gates it
//  can compute exactly, all of which are pure price geometry:
//
//    DEAD SETUP   more than 15% below high of day   gates.py backside_of_hod()
//    BELOW VWAP   price under VWAP                  state_machine abort rule
//    NO CHASING   entry within 25% of armed level   CHASE_CAP_PCT
//    STRUCTURE    at least 4.0 of 15 points         MIN_STRUCTURE_SCORE
//    RED ON DAY   must be green vs prev close       (pre-ignition guard)
// =============================================================================
indicator("ROTD Companion", shorttitle = "ROTD", overlay = true, max_labels_count = 500)

// =============================================================================
// 1 . INPUTS
// =============================================================================
gA = "1 . Gates (price-based)"
chaseCapPct  = input.float(25.0, "Chase cap %  (CHASE_CAP_PCT)",           minval = 1, step = 0.5, group = gA, tooltip = "Never enter more than this % above where the run started. The anti-FOMO rule.")
maxDdHodPct  = input.float(15.0, "Max drawdown from HOD %",                minval = 1, step = 0.5, group = gA, tooltip = "More than this below the high of day = the setup is dead. No entries.")
minStructPts = input.float(4.0,  "Min structure pts (of 15)",              minval = 0, maxval = 15, step = 0.5, group = gA, tooltip = "Structure floor: new high, gap, distance from the low, and drawdown from HOD.")
requireVol   = input.bool(true,  "Require normal-or-better volume",        group = gA, tooltip = "Blocks a run on dead volume: this bar vs its 20-bar average.")
minsRunBars  = input.int(1,      "Bars a run must last before ENTRY",      minval = 0, maxval = 10, group = gA, tooltip = "1 = the first bar of a run can trigger. Raise it to demand confirmation (costs you speed).")

gB = "2 . Timeframes"
structTf    = input.timeframe("5", "Structure timeframe", group = gB, tooltip = "EMAs and ATR are read from this timeframe and drawn on the chart. 5 works on a 1-minute entry chart.")
sessVwap    = input.bool(true,     "Reset VWAP each session", group = gB, tooltip = "ON matches the scanner's intraday VWAP.")

gC = "3 . Lengths"
emaFastLen  = input.int(9,  "Fast EMA",  minval = 1, group = gC)
emaSlowLen  = input.int(21, "Slow EMA",  minval = 1, group = gC)
atrLen      = input.int(14, "ATR length", minval = 1, group = gC)
rvolLen     = input.int(10, "RVOL lookback (sessions)", minval = 2, maxval = 50, group = gC)

gD = "4 . RISK  -  where you get out when wrong"
stopAtrMult = input.float(1.0, "Stop: ATR below VWAP",       minval = 0.1, step = 0.1, group = gD, tooltip = "Hard stop = VWAP - (ATR x this). The scanner aborts under VWAP, so this sits just beneath it.")
minStopPct  = input.float(1.0, "Stop: minimum distance %",   minval = 0.1, step = 0.1, group = gD, tooltip = "Floor so spread alone cannot trigger your stop.")
trailLoose  = input.float(11.0, "Trail %  (normal trend)",   minval = 1, step = 0.5, group = gD, tooltip = "How far price may pull back off the peak before the trend is over.")
trailTight  = input.float(6.0,  "Trail %  (climax)",         minval = 1, step = 0.5, group = gD, tooltip = "Once the move goes vertical, tighten to protect the gain.")
atrLoose    = input.float(2.5,  "Trail ATR mult (normal)",   minval = 0.5, step = 0.1, group = gD)
atrTight    = input.float(1.3,  "Trail ATR mult (climax)",   minval = 0.5, step = 0.1, group = gD)
climaxTrig  = input.float(18.0, "Climax above VWAP %",       minval = 5, step = 1, group = gD, tooltip = "Parabolic threshold: above this the tight trail takes over.")

gE = "5 . TAKE PROFIT  -  where you sell"
tpHard      = input.float(16.0, "Partial at this % above VWAP", minval = 1, step = 1, group = gE, tooltip = "Take a third to a half off once this extended. Greed at the top is the classic runner killer.")
tpWickStretch = input.float(10.0, "Wick TP: stretch above 9 EMA %", minval = 1, step = 1, group = gE)
tpWickPct   = input.float(25.0, "Wick TP: upper wick % of candle", minval = 5, step = 5, group = gE)
tpBarAtr    = input.float(2.2,  "Blow-off TP: bar range x ATR", minval = 1, step = 0.1, group = gE)

gF = "6 . Display"
showLines   = input.bool(true, "VWAP / EMAs / trail", group = gF)
showBands   = input.bool(true, "VWAP bands + climax zone", group = gF)
showPanel   = input.bool(true, "Status panel", group = gF)
alertsOn    = input.bool(true, "alert() calls (webhooks)", group = gF)

// =============================================================================
// 2 . LEVELS
// =============================================================================
// EMAs and ATR from the structure timeframe, as three plain requests.
htfEmaF = request.security(syminfo.tickerid, structTf, ta.ema(close, emaFastLen))
htfEmaS = request.security(syminfo.tickerid, structTf, ta.ema(close, emaSlowLen))
htfAtr  = request.security(syminfo.tickerid, structTf, ta.atr(atrLen))

// Session VWAP built explicitly: Sum(typical x vol) / Sum(vol).
// Explicit rather than ta.vwap() so the deviation bands are exact and the
// script never depends on an overload signature.
newSession = ta.change(time("D")) != 0
var float sumPV = 0.0
var float sumV  = 0.0
var float sumPP = 0.0
if newSession and sessVwap
    sumPV := 0.0
    sumV  := 0.0
    sumPP := 0.0
typPrice = hlc3
sumPV := sumPV + typPrice * volume
sumV  := sumV + volume
sumPP := sumPP + typPrice * typPrice * volume
vwapVal = sumV > 0 ? sumPV / sumV : na
vwapVar = sumV > 0 ? math.max(0.0, sumPP / sumV - vwapVal * vwapVal) : 0.0
vwapSd  = math.sqrt(vwapVar)
band2   = vwapVal + vwapSd * 2.0
band3   = vwapVal + vwapSd * 3.0

// Previous daily values. high[1] + lookahead_on is TradingView's documented
// way to read the last CONFIRMED daily bar, so the day high never repaints.
dHigh  = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_on)
dLow   = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_on)
dClose = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
onDaily  = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly
dayHigh  = onDaily ? high : math.max(nz(dHigh, high), high)
dayLow   = onDaily ? low  : math.min(nz(dLow, low), low)
prevClose = onDaily ? close[1] : nz(dClose, close)

// 52-week low from the last CLOSED week - a slow structural filter, never a stop.
weeklyLow = request.security(syminfo.tickerid, "W", ta.lowest(low, 52), lookahead = barmerge.lookahead_off)

// =============================================================================
// 3 . STRUCTURE SCORE  (0..15, mirrors scoring.py STRUCTURE)
//     All four inputs are visible on this chart, so this agrees with the scanner.
// =============================================================================
lin01(x, lo, hi) => na(x) ? na : math.max(0.0, math.min(1.0, (x - lo) / (hi - lo)))

ddFromHod = dayHigh > 0 ? (dayHigh - close) / dayHigh * 100.0 : na
gapPct    = prevClose > 0 ? (open - prevClose) / prevClose * 100.0 : na
distLow   = not na(weeklyLow) and weeklyLow > 0 ? (close - weeklyLow) / weeklyLow * 100.0 : na

newHighPts  = close >= dayHigh ? 1.0 : 0.0
gapPts      = na(gapPct) ? na : lin01(gapPct, 0.0, 15.0)
distLowPts  = na(distLow) ? na : math.max(0.0, math.min(1.0, 1.0 - distLow / 100.0))
ddPts       = na(ddFromHod) ? na : (ddFromHod >= maxDdHodPct ? 0.0 : lin01(1.0 - ddFromHod / maxDdHodPct, 0.0, 1.0))

structSum = newHighPts
structCnt = 1
if not na(gapPts)
    structSum := structSum + gapPts
    structCnt := structCnt + 1
if not na(distLowPts)
    structSum := structSum + distLowPts
    structCnt := structCnt + 1
if not na(ddPts)
    structSum := structSum + ddPts
    structCnt := structCnt + 1
structPts = structSum / structCnt * 15.0

// =============================================================================
// 4 . TAPE STRENGTH  (no score - just observable facts)
// =============================================================================
emaF = htfEmaF
emaS = htfEmaS
atrS = htfAtr

volAvg   = ta.sma(volume, 20)
volSpike = volAvg > 0 ? volume / volAvg : na

// RVOL: this bar vs the same bar-of-session average from prior sessions.
var array<float> sessVols = array.new<float>()
var array<float> sumVols  = array.new<float>()
var array<float> cntVols  = array.new<float>()
if newSession
    nB = sessVols.size()
    if nB > 0
        for i = 0 to nB - 1
            if i >= sumVols.size()
                sumVols.push(sessVols.get(i))
                cntVols.push(1.0)
            else
                sumVols.set(i, sumVols.get(i) + sessVols.get(i))
                cntVols.set(i, cntVols.get(i) + 1.0)
        sessVols.clear()
        nC = cntVols.size()
        for i = 0 to nC - 1
            if cntVols.get(i) > rvolLen
                cntVols.set(i, float(rvolLen))
posInSession = sessVols.size()
sessVols.push(volume)
hasPrior = posInSession < sumVols.size() and cntVols.get(posInSession) >= 2.0
priorAvg = hasPrior ? sumVols.get(posInSession) / cntVols.get(posInSession) : 0.0
rvol = priorAvg > 0 ? volume / priorAvg : na

// =============================================================================
// 5 . RUN STATE
// =============================================================================
aboveVwap  = not na(vwapVal) and close > vwapVal
emaAligned = not na(emaF) and not na(emaS) and emaF >= emaS * 0.995
inRun      = aboveVwap and emaAligned

runStart = inRun and not inRun[1]

// Explicit counters (never ta.barssince, which is na before the first event).
var int barsInRun = 0
barsInRun := runStart ? 0 : barsInRun + 1

// Armed level: where this run began. The chase cap is measured from here.
var float armedLevel = na
armedLevel := (runStart or na(armedLevel)) ? close : armedLevel
chasePct = armedLevel > 0 ? (close - armedLevel) / armedLevel * 100.0 : 0.0

// =============================================================================
// 6 . RISK MODEL
// =============================================================================
var float peakHigh = na
peakHigh := runStart ? high : (inRun ? math.max(nz(peakHigh[1], high), high) : na)

peakStretch = not na(vwapVal) and vwapVal > 0 ? (nz(peakHigh, high) - vwapVal) / vwapVal * 100.0 : 0.0
isClimax = peakStretch >= climaxTrig

rawStopDist = nz(atrS, vwapVal * 0.02) * stopAtrMult
stopDist = math.max(math.max(rawStopDist, vwapVal * minStopPct / 100.0), syminfo.mintick * 2)
hardStop = vwapVal - stopDist

// Two-speed ratchet trail. Only ever tightens.
trailFrac = (isClimax ? trailTight : trailLoose) / 100.0
trailAtrD = nz(atrS, 0.0) * (isClimax ? atrTight : atrLoose)
rawTrail  = nz(peakHigh, high) - math.max(nz(peakHigh, high) * trailFrac, trailAtrD)
var float trailLine = na
if runStart
    trailLine := rawTrail
else if inRun
    trailLine := math.max(nz(trailLine, rawTrail), rawTrail)

trailUsable   = inRun and not na(trailLine)
effectiveStop = trailUsable ? math.max(hardStop, nz(trailLine, hardStop)) : hardStop
riskPct       = close > 0 ? (close - effectiveStop) / close * 100.0 : na
stopBreached  = not na(effectiveStop) and close < effectiveStop

// =============================================================================
// 7 . TAKE PROFIT  (ladder - partials into strength)
// =============================================================================
emaStretch   = emaF > 0 ? (high - emaF) / emaF * 100.0 : 0.0
vwapStretch  = vwapVal > 0 ? (high - vwapVal) / vwapVal * 100.0 : 0.0
barRange     = high - low
upperWickPct = barRange > 0 ? (high - close) / barRange * 100.0 : 0.0
enoughBars   = barsInRun >= 2

var bool blowUsed = false
var bool hardUsed = false
if runStart
    blowUsed := false
    hardUsed := false

tpWick    = inRun and enoughBars and emaStretch >= tpWickStretch and vwapStretch >= tpHard and upperWickPct >= tpWickPct
tpBlowoff = inRun and enoughBars and not blowUsed and vwapStretch >= tpHard and barRange >= nz(atrS, barRange) * tpBarAtr
tpHardTp  = inRun and enoughBars and not hardUsed and close >= vwapVal * (1.0 + tpHard / 100.0) and upperWickPct < 50.0

// A breached stop vetoes TP: the stop wins the same bar.
tpRaw = (tpWick or tpBlowoff or tpHardTp) and not stopBreached and barstate.isconfirmed
if tpRaw
    if tpBlowoff
        blowUsed := true
    if tpHardTp
        hardUsed := true

// =============================================================================
// 8 . EXIT
// =============================================================================
runExtended = not na(vwapVal) and vwapVal > 0 and (ta.highest(high, 10) - vwapVal) / vwapVal * 100.0 >= 8.0
lostStop    = not na(effectiveStop[1]) and close < effectiveStop[1]
lostVwap    = ta.crossunder(close, vwapVal)

exitRaw = runExtended and (lostStop or lostVwap) and barstate.isconfirmed

// Cooldowns count bars since the last ACCEPTED signal, not the raw condition.
var int sinceExit = 999
var int sinceTp   = 999
cleanExit = exitRaw and sinceExit > 8 and not tpRaw
cleanTp   = tpRaw and sinceTp > 6 and not cleanExit
sinceExit := cleanExit ? 0 : sinceExit + 1
sinceTp := cleanTp ? 0 : sinceTp + 1

// Hard "get out" marker: stop gone, without the extended-run filter.
stopHit = lostStop and not cleanExit and barstate.isconfirmed

// =============================================================================
// 9 . ENTRY GATE
// =============================================================================
backside    = not na(ddFromHod) and ddFromHod > maxDdHodPct
belowVwap   = not aboveVwap
chaseBlocked = chasePct > chaseCapPct
structOk    = structPts >= minStructPts
greenOnDay  = na(prevClose) ? true : close > prevClose
volOk       = not requireVol or na(volSpike) or volSpike >= 1.0
priceAbove9 = emaF > 0 and close >= emaF
barsOk      = barsInRun >= minsRunBars

tradeable = inRun and not backside and not chaseBlocked and structOk and greenOnDay and volOk and priceAbove9 and barsOk
entryTrig = tradeable and runStart and barstate.isconfirmed

// =============================================================================
// 10 . PLOTS
// =============================================================================
plot(showLines ? emaF : na, "9 EMA", color.new(color.green, 0), 2)
plot(showLines ? emaS : na, "21 EMA", color.new(color.red, 0), 2)
plot(showLines ? vwapVal : na, "VWAP", color.new(color.purple, 0), 2)
plot(showLines and trailUsable ? trailLine : na, "Trail", color.new(color.yellow, 0), 2, plot.style_linebr)
plot(showLines ? hardStop : na, "Hard stop", color.new(color.red, 40), 1, plot.style_linebr)
plot(showLines and trailUsable ? effectiveStop : na, "Stop in use", color.new(color.orange, 0), 1, plot.style_linebr)

pB2 = plot(showBands ? band2 : na, "+2 sigma", color.new(color.red, 75), 1)
pB3 = plot(showBands ? band3 : na, "+3 sigma", color.new(color.red, 55), 1)
fill(pB2, pB3, color.new(color.red, 86), "Climax zone")

plotshape(entryTrig, "ENTRY", shape.triangleup, location.belowbar, color.new(color.aqua, 0), size = size.small, text = "ENTRY", textcolor = color.aqua)
plotshape(cleanTp, "TAKE PROFIT", shape.triangledown, location.abovebar, color.new(color.lime, 0), size = size.small, text = "TP", textcolor = color.lime)
plotshape(cleanExit, "EXIT", shape.xcross, location.belowbar, color.new(color.red, 0), size = size.small, text = "EXIT", textcolor = color.red)
plotshape(stopHit, "STOP", shape.labeldown, location.abovebar, color.new(color.maroon, 0), size = size.small, text = "STOP", textcolor = color.white)

bgcolor(tradeable ? color.new(color.teal, 92) : na, title = "Tradeable")
bgcolor(backside and inRun ? color.new(color.red, 88) : na, title = "Backside of HOD")

// =============================================================================
// 11 . STATUS PANEL
// =============================================================================
var table panel = table.new(position.top_right, 2, 9, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))
if barstate.islast and showPanel
    status = tradeable ? "TRADEABLE" : backside ? "NO - BACKSIDE OF HOD" : belowVwap ? "NO - BELOW VWAP" : chaseBlocked ? "NO - TOO EXTENDED" : not structOk ? "NO - WEAK STRUCTURE" : not greenOnDay ? "NO - RED ON DAY" : not volOk ? "NO - DEAD VOLUME" : not priceAbove9 ? "NO - UNDER 9 EMA" : "WAIT"
    statusColor = tradeable ? color.new(color.green, 20) : color.new(color.red, 20)
    table.cell(panel, 0, 0, "ROTD", text_color = color.white, bgcolor = color.new(color.blue, 30), text_size = size.small)
    table.cell(panel, 1, 0, status, text_color = color.white, bgcolor = statusColor, text_size = size.small)
    table.cell(panel, 0, 1, "Price", text_size = size.small)
    table.cell(panel, 1, 1, str.tostring(close, format.mintick), text_size = size.small)
    table.cell(panel, 0, 2, "Stop in use", text_size = size.small)
    table.cell(panel, 1, 2, na(effectiveStop) ? "-" : str.tostring(effectiveStop, format.mintick), text_size = size.small, text_color = color.orange)
    table.cell(panel, 0, 3, "Risk %", text_size = size.small)
    table.cell(panel, 1, 3, stopBreached ? "STOP HIT - EXIT" : (na(riskPct) ? "-" : str.tostring(riskPct, "#.##") + "%"), text_size = size.small, text_color = stopBreached ? color.red : color.white)
    table.cell(panel, 0, 4, "Mode", text_size = size.small)
    table.cell(panel, 1, 4, isClimax ? "CLIMAX (tight trail)" : "TREND (loose trail)", text_size = size.small)
    table.cell(panel, 0, 5, "Stretch vs VWAP", text_size = size.small)
    table.cell(panel, 1, 5, str.tostring(vwapStretch, "#.#") + "%", text_size = size.small)
    table.cell(panel, 0, 6, "Structure", text_size = size.small)
    table.cell(panel, 1, 6, str.tostring(structPts, "#.#") + " / 15", text_size = size.small, text_color = structOk ? color.lime : color.red)
    table.cell(panel, 0, 7, "Chase", text_size = size.small)
    table.cell(panel, 1, 7, str.tostring(chasePct, "#.#") + "%", text_size = size.small, text_color = chaseBlocked ? color.red : color.green)
    table.cell(panel, 0, 8, "RVOL", text_size = size.small)
    table.cell(panel, 1, 8, na(rvol) ? "building..." : str.tostring(rvol, "#.##") + "x", text_size = size.small)

// =============================================================================
// 12 . ALERTS
// =============================================================================
alertcondition(entryTrig, "ROTD ENTRY", "ROTD ENTRY {{ticker}} @ {{close}}")
alertcondition(cleanTp, "ROTD TAKE PROFIT", "ROTD TP {{ticker}} @ {{close}}")
alertcondition(cleanExit, "ROTD EXIT", "ROTD EXIT {{ticker}} @ {{close}}")

if alertsOn
    if entryTrig
        alert(str.format("ROTD ENTRY {0} @ {1} | STOP {2} | risk {3}%", syminfo.ticker, str.tostring(close, format.mintick), str.tostring(effectiveStop, format.mintick), str.tostring(riskPct, "#.##")), alert.freq_once_per_bar_close)
    if cleanTp
        alert(str.format("ROTD TP {0} @ {1}", syminfo.ticker, str.tostring(close, format.mintick)), alert.freq_once_per_bar_close)
    if cleanExit
        alert(str.format("ROTD EXIT {0} @ {1}", syminfo.ticker, str.tostring(close, format.mintick)), alert.freq_once_per_bar_close)
