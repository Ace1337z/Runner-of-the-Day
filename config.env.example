# ROTD configuration template.
#
# Copy to $HOME/.rotd/rotd.env (the installer does this for you). Keep it mode 600.
# Secrets are never read from the command line and are redacted from logs.
#
# Only TELEGRAM_TOKEN + TELEGRAM_CHAT_ID are asked at install. Every other key
# defaults to '' (safe) and can be added later from Telegram via:
#   /setkey FINVIZ_TOKEN <token>
#   /setkey FINNHUB_KEY <key>
#   /setkey ALPACA_KEY <key> / /setkey ALPACA_SECRET <secret>
#   /setkey AI_KEY <key> / /setkey AI_BASE_URL <url> / /setkey AI_MODEL <name>
#   /setkey ALPHA_VANTAGE_KEY <key>
# (commands are accepted only from the configured TELEGRAM_CHAT_ID)

# --- Telegram (asked at install) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Source API keys (defaults: '' = not configured) ---
# Finviz Elite is the only key required to run (universe + extended-hours price).
FINVIZ_TOKEN=
FINNHUB_KEY=
ALPHA_VANTAGE_KEY=
ALPACA_KEY=
ALPACA_SECRET=

# --- SEC EDGAR user agent (required by SEC for fair use) ---
SEC_USER_AGENT=ROTD research contact@example.com

# --- runtime / shadow gate ---
SHADOW=1
SHADOW_AUTOSTART=1
SHADOW_DAYS_REQUIRED=10

# --- universe scope (Upgrade 6) ---
# MAX_MARKET_CAP=100000000 (default) means the universe is every name with a
# market cap <= $100M, regardless of share price (high-priced micro-caps qualify).
# Set MAX_MARKET_CAP=0 to fall back to the legacy sub-$10 price ceiling MAX_PRICE.
# MAX_PRICE=10.00
# MAX_MARKET_CAP=100000000

# --- price conflict tolerance (Bug Fix 3) ---
# Wide (50%) on purpose: micro-caps jump +20-30% in seconds and unverified helper
# feeds lag, so a tight tolerance would falsely flag CONFLICT and drop runners.
# PRICE_CONFLICT_PCT_REG=50.0
# PRICE_CONFLICT_PCT_EXT=50.0

# --- alert budget (Upgrade 5) ---
# ALERT_BUDGET_PER_DAY=5  (+1 reserve for EXCEPTIONAL_SCORE names)
# ALERT_BUDGET_MIN=1
# ALERT_BUDGET_MAX=10
# Change it live from Telegram: /setbudget N

# --- gates that need a feed this deployment does not have (VERIFIED G-18) ---
# 0 = NOT_ENFORCED (passes, reported in MISS REPORT). Set 1 once a book/bar feed
# exists (e.g. Alpaca unblocked for the bid/ask book).
USE_SPREAD_GATE=0
USE_LIQ_GATE=0
USE_EXIT_GATE=0

# --- optional: methodology_v3 catalyst auditor model endpoint (rules-only if blank) ---
# AI_BASE_URL=
# AI_KEY=
# AI_MODEL=deepseek-v4.1-flash

# --- tuning: faster catch of momentum runners (defaults shown) ---
IGNITION_THRESHOLD=70
ARM_MIN_SCORE=68
ARM_MAX_RANK=3
REG_CONFIRM_BARS=1
EXT_CONFIRM_BARS=1
CHASE_CAP_PCT=25.0
MIN_VOL_3M_SHARES=15000
MIN_DVOL_10M_REG=40000
MIN_DVOL_10M_EXT=15000
MIN_STRUCTURE_SCORE=4.0
MAX_DRAWDOWN_FROM_HOD_PCT=15.0

# --- AI auditor request timeout (long 28k-char prompts need 30s) ---
AI_TIMEOUT_S=30

# --- catalyst cause window: premarket/morning releases stay fresh through midday ---
AI_CAUSE_WINDOW_H=14

# --- retention / bloat guard (2h is enough; keeps rotd.db small) ---
RAW_RETENTION_HOURS=2
CAND_RETENTION_HOURS=2
DB_PRUNE_INTERVAL_S=300
