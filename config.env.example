# ROTD configuration template.
#
# Copy to $HOME/.rotd/rotd.env (the installer does this for you). Keep it mode 600.
# Secrets are never read from the command line and are redacted from logs.
#
# Only TELEGRAM_TOKEN + TELEGRAM_CHAT_ID are asked at install. Every other key
# defaults to '' (safe) and can be added later from Telegram via:
#   /setkey FINVIZ_TOKEN <token>
#   /setkey FINNHUB_KEY <key>
#   /setkey ALPACA_KEY <key> / /setkey ALPACA_SECRET <secret>
#   /setkey AI_KEY <key> / /setkey AI_BASE_URL <url> / /setkey AI_MODEL <name>
#   /setkey ALPHA_VANTAGE_KEY <key>
# (commands are accepted only from the configured TELEGRAM_CHAT_ID)

# --- Telegram (asked at install) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Source API keys (defaults: '' = not configured) ---
# Finviz Elite is the only key required to run (universe + extended-hours price).
FINVIZ_TOKEN=
FINNHUB_KEY=
ALPHA_VANTAGE_KEY=
ALPACA_KEY=
ALPACA_SECRET=

# --- SEC EDGAR user agent (required by SEC for fair use) ---
SEC_USER_AGENT=ROTD research contact@example.com

# --- runtime / shadow gate ---
SHADOW=1
SHADOW_AUTOSTART=1
SHADOW_DAYS_REQUIRED=10

# --- universe scope (Upgrade 6) ---
# MAX_MARKET_CAP=100000000 (default) means the universe is every name with a
# market cap <= $100M, regardless of share price (high-priced micro-caps qualify).
# Set MAX_MARKET_CAP=0 to fall back to the legacy sub-$10 price ceiling MAX_PRICE.
# MAX_PRICE=10.00
# MAX_MARKET_CAP=100000000

# --- price conflict tolerance (Bug Fix 3) ---
# Wide on purpose: micro-caps jump +20-30% in seconds and unverified helper
# feeds lag, so a tight tolerance would falsely flag CONFLICT and drop runners.
# The extended-hours tolerance is 95%, not 250%. The gap is measured RELATIVE
# to the higher price, so it can never reach 100%: 250 would silently disable
# conflict detection and accept two sources that disagree by 40x.
# PRICE_CONFLICT_PCT_REG=50.0
# PRICE_CONFLICT_PCT_EXT=95.0

# --- alert budget (Candle-1 release) ---
# 30/day + 1 reserve for EXCEPTIONAL_SCORE names. The budget is a supply
# constraint, not a quality gate: MIN_STRUCTURE_SCORE / HOD / chase cap do the
# filtering, so a busy session is allowed to push more ignitions.
ALERT_BUDGET_PER_DAY=30
ALERT_BUDGET_MIN=1
ALERT_BUDGET_MAX=50
# Change it live from Telegram: /setbudget N

# --- liquidity / spread / exit gates ---
# G-SPREAD is ON in production. It is SMART: a MEASURED wide spread is rejected
# (F_SPREAD_WIDE), but a missing book (Finviz "Spread n/a", common pre-market)
# passes as SPREAD_NOT_ENFORCED instead of blocking a valid runner.
# USE-LIQ and USE-EXIT still need a 15m bar feed this deployment does not have
# (VERIFIED G-18), so they stay 0 = NOT_ENFORCED (reported in MISS REPORT).
USE_SPREAD_GATE=1
USE_LIQ_GATE=0
USE_EXIT_GATE=0

# --- optional: methodology_v3 catalyst auditor model endpoint (rules-only if blank) ---
# AI_BASE_URL=
# AI_KEY=
# AI_MODEL=deepseek-v4.1-flash

# --- tuning: Candle-1 speed + pre-ignition safety (production defaults) ---
IGNITION_THRESHOLD=70
ARM_MIN_SCORE=70
ARM_MAX_RANK=3
REG_CONFIRM_BARS=1
EXT_CONFIRM_BARS=1
CHASE_CAP_PCT=18.0
MIN_VOL_3M_SHARES=50000
MIN_DVOL_10M_REG=150000
MIN_DVOL_10M_EXT=75000
MIN_STRUCTURE_SCORE=2.0
MAX_DRAWDOWN_FROM_HOD_PCT=15.0

# Ignition tolerates a wick this far BELOW VWAP (a retest of VWAP support)
# instead of aborting on a strict price < vwap test.
VWAP_IGNITION_TOLERANCE_PCT=0.5

# MIDDAY only: TAPE raw score needed to ignite, so a slow 2-hour stair-step
# grind cannot ride maxed FUEL/STRUCTURE/CONTEXT to an alert. 0 = disable.
MIDDAY_MIN_TAPE_RAW=0.72

# --- Stage-1 scoring weights (80-point raw scale; rescaled to 0..100) ---
# W_CATALYST is small on purpose: the LLM catalyst number is noisy, and a low
# reading must not anchor a pure momentum runner below ARM_MIN_SCORE.
W_TAPE=30
W_CATALYST=5
W_FUEL=20
W_STRUCTURE=15
W_CONTEXT=10

# --- AI auditor timeouts (Candle-1: fail fast, rules-only on timeout) ---
AI_TIMEOUT_S=12
CATALYST_TIMEOUT_S=15

# --- catalyst cause window: premarket/morning releases stay fresh through midday ---
AI_CAUSE_WINDOW_H=14

# --- subscription expiry reminders (T-7/T-3/T-1/T-0 renewal DMs) ---
# Set RENEW_URL to your payment link; the button is omitted when empty.
RENEW_URL=
EXPIRY_REMINDERS=0
EXPIRY_REMINDER_INTERVAL_S=3600

# --- retention / bloat guard (1h is plenty at a 10s poll; keeps rotd.db small) ---
RAW_RETENTION_HOURS=1
CAND_RETENTION_HOURS=1
DB_PRUNE_INTERVAL_S=300

# --- fast Candle-1 polling (production defaults) ---
# Every phase polls at 10s so a fresh ignition is caught on its first candle.
# UNIVERSE/MOVERS drive discovery; *_POLL_S drive the decision cycle per mode.
QUALIFY_CONSEC=1
BOARD_MIN_DWELL_S=15
QUOTE_CACHE_TTL_S=10
UNIVERSE_POLL_S=15
MOVERS_POLL_S=10
PRE_POLL_S=10
OPEN_POLL_S=10
